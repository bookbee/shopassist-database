# ShopAssist :: environment configuration template.
# Copy to .env and adjust for your environment:
#   cp .env.example .env
#
# .env itself is git-ignored so real/staging credentials are never committed.
# A .env with these same development defaults already exists locally so
# `docker compose up -d` works out of the box for local development.

POSTGRES_DB=shopassist
POSTGRES_USER=shopassist
POSTGRES_PASSWORD=shopassist123
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
TZ=UTC
