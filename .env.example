# ShopAssist :: environment configuration template.
# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# .env is git-ignored (see .gitignore) - every value below has a working
# default for local dev, so `docker compose up -d` and the
# postgres/scripts/*.py helpers work immediately even without a .env at
# all. For staging/production, set real secrets via your deployment
# platform's secret manager instead of a checked-in .env.

# --- PostgreSQL ---------------------------------------------------------
# Read by docker-compose.yml (via ${VAR:-default} substitution) and by
# postgres/scripts/db_common.py for the non-Docker (create_db.py/
# reset_db.py) path. POSTGRES_HOST=localhost is correct for connecting
# from the host machine to the Dockerized Postgres below, or to any local
# `postgres` server; point it elsewhere for a remote/staging server.
POSTGRES_DB=shopassist
POSTGRES_USER=shopassist
POSTGRES_PASSWORD=shopassist123
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# IANA zoneinfo name for IST (UTC+5:30) - "IST" itself isn't a portable TZ
# value (ambiguous with Irish/Israel Standard Time on some systems).
# Sets the Postgres container's OS timezone and its `timezone` GUC
# default (via PGTZ in docker-compose.yml) - see schema.sql's own
# `SET timezone` for the matching per-session setting.
TZ=Asia/Kolkata

# --- Ollama (RAG embeddings) ---------------------------------------------
# Read by postgres/scripts/init_vector_store.py (via
# db_common.py::get_ollama_config()) to embed postgres/rag_sources/ into
# document_chunks - see README.md's RAG section. Needs the embedding
# model already pulled: `ollama pull nomic-embed-text`.
#
# OLLAMA_API_BASE_URL here only applies when running init_vector_store.py
# directly on the host - docker-compose.yml's `rag-init` service
# (docker compose --profile rag up rag-init) hardcodes its own
# host.docker.internal value instead of reading this one, since
# "localhost" means something different inside that container. See that
# service's own comments in docker-compose.yml before changing this
# value if RAG ingestion via Docker Compose stops finding Ollama.
OLLAMA_API_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
